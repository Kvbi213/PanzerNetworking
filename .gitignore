# PanzerNetworking .gitignore
.env
*.env
*.key
*.pem
*.cert
*.crt
*.pfx

# System & runtime
node_modules/
dist/
target/
__pycache__/
*.pyc
*.min.css

# Data zones
data/logs/*
data/scans/*
!data/logs/.gitkeep
!data/scans/.gitkeep
!data/reports/.gitkeep
!data/finanse/.gitkeep

# Media & Video production plans (Internal/Obsidian only)
docs/media/
*.mp4
*.mov
*.avi
*.mkv

# OS specific
.DS_Store
Thumbs.db
